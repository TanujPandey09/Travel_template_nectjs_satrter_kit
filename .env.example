# =========================================================================
# TRAVELI • STARTER KIT ENVIRONMENT VARIABLES
# =========================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# 1. Base Canonical Site URL (Used for Metadata, Sitemap & OpenGraph)
NEXT_PUBLIC_SITE_URL=https://traveli.in

# 2. Optional: Contact Form Notification Webhook / Resend API
# If configured, lead captures from /contact and PlanJourneyModal will forward
# to your CRM, Slack, or Email inbox.
# RESEND_API_KEY=re_123456789
# CONTACT_NOTIFICATION_EMAIL=concierge@yourtravelagency.com
# SLACK_LEAD_WEBHOOK_URL=https://hooks.slack.com/services/...

